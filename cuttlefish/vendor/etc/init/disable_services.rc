service vendor.uwb_hal /apex/com.android.hardware.uwb/bin/hw/android.hardware.uwb-service
    override
    disabled

service vendor.oemlock_default /apex/com.google.cf.oemlock/bin/hw/android.hardware.oemlock-service.remote
    override
    disabled

service vendor.threadnetwork_hal /apex/com.android.hardware.threadnetwork/bin/hw/android.hardware.threadnetwork-service
    override
    disabled

service vendor.light-cuttlefish /apex/com.google.cf.light/bin/hw/android.hardware.light-service.cuttlefish
    override
    disabled

service netd /system/bin/netd
    override
    class main
    user root
    group root net_admin

on early-init
    setprop ro.boot.dynamic_partitions 1
    setprop ro.boot.bootcontrol none
    setprop ro.boot.slot_suffix ""
    exec u:r:init:s0 root root -- /system/bin/toybox mkdir -p /dev/socket
    exec u:r:init:s0 root root -- /system/bin/toybox touch /dev/socket/rpmb_mock_system
    exec u:r:init:s0 root root -- /system/bin/toybox mkdir -p /dev/block/by-name
    exec u:r:init:s0 root root -- /system/bin/toybox dd if=/dev/zero of=/dev/block/by-name/misc bs=1024 count=4
    exec u:r:init:s0 root root -- /system/bin/toybox mknod /dev/loop-control c 10 237
    chmod 0660 /dev/loop-control
    chown root system /dev/loop-control
    restorecon /system/bin/app_process64
    restorecon /system/bin/app_process32
    restorecon /system/bin/idmap2d
    restorecon /system/bin/adbd
    setprop service.adb.tcp.port 5555
    setprop ctl.stop keystore2
    setprop ctl.stop storageproxyd_system
    setprop trusty.security_vm.nonsecure_vm_ready 0

on post-fs-data
    exec_background u:r:init:s0 root root -- /system/bin/logcat -b main,system,crash -f /dev/kmsg

service vendor.boot-default /apex/com.android.hardware.boot/bin/hw/android.hardware.boot-service.default
    override
    disabled

service storaged /system/bin/storaged
    override
    disabled

service dumpstate /system/bin/dumpstate
    override
    disabled

service incidentd /system/bin/incidentd
    override
    disabled

service statsd /system/bin/statsd
    override
    disabled

service traced /system/bin/traced
    override
    disabled

service heapprofd /system/bin/heapprofd
    override
    disabled

service credstore /system/bin/credstore
    override
    disabled

service media /system/bin/media
    override
    disabled

service vold /system/bin/toybox true
    override
    disabled

service cameraserver /system/bin/cameraserver
    override
    disabled

service audioserver /system/bin/audioserver
    override
    disabled

service mediaextractor /system/bin/mediaextractor
    override
    disabled

service vendor.boot-default /system/bin/toybox sleep infinity
    override
    class hal
    user root

service profcollectd /system/bin/profcollectd
    override
    disabled

on post-fs-data
    setprop service.adb.tcp.port 5555
    setprop persist.adb.tcp.port 5555
    setprop sys.usb.config adb
    setprop persist.sys.usb.config adb
    stop socket_vsock_proxy
    exec u:r:init:s0 root root -- /system/bin/toybox pkill -9 vold
    trigger zygote-start
    setprop ctl.stop vendor.boot-default
    setprop ctl.stop mediaextractor
    setprop ctl.stop credstore
    setprop ctl.stop keystore2
    setprop ctl.stop storageproxyd_system
    restorecon /data
    mkdir /data/dalvik-cache 0771 root root
    mkdir /data/dalvik-cache/arm64 0771 root root
    mkdir /data/misc 0771 system system
    mkdir /data/misc/keystore 0700 1017 1017
    restorecon /data/misc/keystore
    mkdir /data/system 0775 system system
    mkdir /data/system/users 0775 system system
    start surfaceflinger
    setprop vold.post_fs_data_done 1
    exec u:r:init:s0 root root -- /system/bin/toybox pkill -9 vold
    trigger zygote-start

on boot
    setprop ctl.stop vendor.boot-default
    setprop ctl.stop mediaextractor
    setprop ctl.stop credstore
    setprop service.adb.tcp.port 5555
    setprop sys.usb.config adb
    setprop persist.sys.usb.config adb
    start adbd
    # vold decrypt trigger disabled
    exec u:r:init:s0 root root -- /system/bin/toybox pkill -9 vold
    trigger zygote-start
    class_start early_hal
    class_start hal
    class_start core
    class_start animation
    class_start main
    class_start late_start

on late-init
    setprop ctl.stop vendor.boot-default
    setprop ctl.stop mediaextractor
    setprop ctl.stop credstore
    setprop service.adb.tcp.port 5555
    setprop sys.usb.config adb
    setprop persist.sys.usb.config adb
    start adbd
    # vold decrypt trigger disabled
    exec u:r:init:s0 root root -- /system/bin/toybox pkill -9 vold
    trigger zygote-start


on property:apexd.status=ready
    setprop service.adb.tcp.port 5555
    setprop sys.usb.config adb
    setprop persist.sys.usb.config adb
    restart adbd

on property:init.svc.vold=running
    stop vold
    exec u:r:init:s0 root root -- /system/bin/toybox killall -9 vold

on property:init.svc.vendor.boot-default=running
    stop vendor.boot-default

on property:init.svc.mediaextractor=running
    stop mediaextractor

on property:init.svc.credstore=running
    stop credstore
    class_start early_hal
    class_start hal
    class_start core
    class_start animation
    class_start main
    class_start late_start








