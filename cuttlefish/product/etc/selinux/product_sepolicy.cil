(typeattributeset unconstrained_vsock_violators (storageproxyd_system tombstone_transmit ))
(type tombstone_transmit)
(roletype object_r tombstone_transmit)
(type tombstone_transmit_exec)
(roletype object_r tombstone_transmit_exec)
(type vsock_tombstone_port_prop)
(roletype object_r vsock_tombstone_port_prop)
;;* lmx 4 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow init tombstone_transmit_exec (file (read getattr map execute open)))
;;* lme
;;* lmx 4 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow init tombstone_transmit (process (transition)))
;;* lme
;;* lmx 4 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow tombstone_transmit tombstone_transmit_exec (file (read getattr map execute open entrypoint)))
;;* lme
(dontaudit init tombstone_transmit (process (noatsecure)))
;;* lmx 4 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow init tombstone_transmit (process (siginh rlimitinh)))
;;* lme
(typetransition init tombstone_transmit_exec process tombstone_transmit)
;;* lmx 6 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(neverallow base_typeattr_232 vsock_tombstone_port_prop (file (ioctl read write create setattr lock relabelfrom append unlink link rename open watch watch_mount watch_sb watch_with_perm watch_reads)))
;;* lme
;;* lmx 7 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow tombstone_transmit vsock_tombstone_port_prop (file (read getattr map open)))
;;* lme
;;* lmx 9 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow tombstone_transmit self (capability (net_admin)))
;;* lme
;;* lmx 10 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow tombstone_transmit tombstone_data_file (dir (ioctl read getattr lock open watch watch_reads search)))
;;* lme
;;* lmx 10 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow tombstone_transmit tombstone_data_file (file (ioctl read getattr lock map open watch watch_reads)))
(allow tombstone_transmit tombstone_data_file (lnk_file (ioctl read getattr lock map open watch watch_reads)))
;;* lme
;;* lmx 13 device/google/cuttlefish/shared/sepolicy/product/private/tombstone_transmit.te
(allow tombstone_transmit self (vsock_socket (read write create getattr setattr lock append map bind connect getopt setopt shutdown)))
;;* lme

