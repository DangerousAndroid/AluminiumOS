#<src>                                                   <mnt_point>                 <type>  <mnt_flags and options>  <fs_mgr_flags>
system                                                   /system                     ext4    noatime,ro                       wait,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
# During compliance testing, the previous line would fail (because GSI is ext4), and the next line would be used to mount GSI.
system                                                   /system                     ext4    noatime,ro                       wait,logical,first_stage_mount,readahead_size_kb=128
vendor                                                   /vendor                     ext4    noatime,ro                       wait,logical,first_stage_mount,readahead_size_kb=128
/dev/block/sda6                                          /metadata                   ext4    noatime,nosuid,nodev
